{% if minio_enable_tls | bool and (minio_tls_active | default(false)) %}
server {
    listen 80;
    server_name {{ minio_api_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name {{ minio_console_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ minio_api_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ minio_api_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ minio_api_domain }}/privkey.pem;

    access_log /var/log/nginx/minio-api.access.log;
    error_log /var/log/nginx/minio-api.error.log;

    client_max_body_size 0;

    location / {
        proxy_pass {{ minio_nginx_api_upstream_url }};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ minio_console_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ minio_api_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ minio_api_domain }}/privkey.pem;

    access_log /var/log/nginx/minio-console.access.log;
    error_log /var/log/nginx/minio-console.error.log;

    client_max_body_size 0;

    location / {
        proxy_pass {{ minio_nginx_console_upstream_url }};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }
}
{% else %}
server {
    listen 80;
    server_name {{ minio_api_domain }};

    access_log /var/log/nginx/minio-api.access.log;
    error_log /var/log/nginx/minio-api.error.log;

    client_max_body_size 0;

    location / {
        proxy_pass {{ minio_nginx_api_upstream_url }};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }
}

server {
    listen 80;
    server_name {{ minio_console_domain }};

    access_log /var/log/nginx/minio-console.access.log;
    error_log /var/log/nginx/minio-console.error.log;

