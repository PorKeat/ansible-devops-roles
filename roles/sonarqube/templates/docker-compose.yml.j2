services:
  postgresql:
    image: {{ postgres_image | quote }}
    container_name: {{ postgres_container_name | quote }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ postgres_port }}:5432"
    environment:
      POSTGRES_DB: {{ sonarqube_db_name | quote }}
      POSTGRES_USER: {{ sonarqube_db_user | quote }}
      POSTGRES_PASSWORD: {{ sonarqube_db_password | quote }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U {{ sonarqube_db_user }} -d {{ sonarqube_db_name }}
      interval: 10s
      timeout: 5s
      retries: 10

  sonarqube:
    image: {{ sonarqube_image | quote }}
    container_name: {{ sonarqube_container_name | quote }}
    restart: unless-stopped
    depends_on:
      postgresql:
        condition: service_healthy
    ports:
      - "{{ sonarqube_http_port }}:9000"
    environment:
      SONAR_JDBC_URL: "jdbc:postgresql://postgresql:5432/{{ sonarqube_db_name }}"
      SONAR_JDBC_USERNAME: {{ sonarqube_db_user | quote }}
      SONAR_JDBC_PASSWORD: {{ sonarqube_db_password | quote }}
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_extensions:/opt/sonarqube/extensions
      - sonarqube_logs:/opt/sonarqube/logs

volumes:
  postgres_data:
  sonarqube_data:
  sonarqube_extensions:
  sonarqube_logs:
